# Destination publique de la page /rendez-vous.
# Ces valeurs sont intégrées au build Next.js. Toute modification impose un nouveau déploiement.
NEXT_PUBLIC_CALENDAR_PROVIDER_NAME=Cal.eu
NEXT_PUBLIC_CALENDAR_URL=https://www.cal.eu/florianbrignoli/quick-chat

# Google Business Profile — secrets fournis uniquement au runtime dans Coolify.
# Ne jamais préfixer ces valeurs par NEXT_PUBLIC_, ni les mettre dans les arguments Docker.
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REFRESH_TOKEN=
# Nom interne API, distinct du lien public g.page et du CID Google Maps.
GOOGLE_BUSINESS_LOCATION=
